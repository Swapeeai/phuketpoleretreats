# Stripe (optional for local demo)
# Without these keys the site uses a mock checkout so you can still walk through
# pay-in-full and the €500 deposit + monthly installment schedule.

STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Public URL used for Stripe success/cancel redirects.
# Canonical, Open Graph and sitemap URLs ignore any vercel.app value and
# fall back to https://www.phuketpoleretreats.com.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:43211

# --- Ads & analytics ---
# Google IDs are inlined at build time. Set them in Vercel → Project → Settings →
# Environment Variables, then redeploy. Do not commit Google IDs.

# Optional Meta Pixel override (digits only). If unset, the site uses the public
# Pixel 1078532138132230. The tag still loads only after the visitor clicks Accept.
# Copy a replacement from Meta Events Manager → Data sources → your pixel → Settings → Pixel ID.
# NEXT_PUBLIC_META_PIXEL_ID=

# GA4 Measurement ID, looks like G-XXXXXXXX.
# Copy from Google Analytics → Admin → Data streams → your web stream → Measurement ID.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Ads tag ID, looks like AW-123456789 (not the conversion label).
# Copy from Google Ads → Goals → Conversions → Google tag, or Tools → Data manager → Google tag → Tag ID.
NEXT_PUBLIC_GOOGLE_ADS_ID=

# Search Console ownership token only (the content value, not the whole meta tag).
# Copy from Google Search Console → Settings → Ownership verification → HTML tag.
# The meta tag is rendered only when this is set.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Booking confirmation emails (server only — never NEXT_PUBLIC_).
# The Stripe webhook sends these after checkout.session.completed when the
# payment status is paid. Nothing is emailed when checkout is created.
# Copy the API key from Resend → API Keys. Do not commit a real key.
RESEND_API_KEY=re_...
# Optional From header. If unset, the server uses:
# Phuket Pole Retreats <bookings@phuketpoleretreats.com>
# Keep this on phuketpoleretreats.com. Do not switch the From domain.
BOOKING_FROM=
# Optional Reply-To. If unset, the server uses its built-in reply-to.
# Server only. Do not prefix with NEXT_PUBLIC_.
BOOKING_REPLY_TO=
# Comma-separated organizer inboxes for the new-booking alert.
# Spaces around each comma are trimmed. If this is empty, the guest email
# is still sent and the skip is logged. Set the real addresses in Vercel only.
BOOKING_NOTIFY_EMAILS=
